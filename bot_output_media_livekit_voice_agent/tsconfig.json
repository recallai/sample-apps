{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "sourceMap": true,
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "types": ["node", "vite/client"]
    },
    "include": ["src", "vite.config.ts"]
}
