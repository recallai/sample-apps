# Recall.ai v1.11
RECALL_REGION=us-east-1
RECALL_API_KEY=
MEETING_URL=
BOT_NAME=LiveKit Voice Agent

# Public URL for the Vite dev server, such as a reserved ngrok domain.
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app

# LiveKit Cloud project
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=recall-livekit-voice-agent

# Generate with: openssl rand -base64 32
OUTPUT_MEDIA_SIGNING_SECRET=
OUTPUT_MEDIA_SESSION_TTL_SECONDS=3600
LIVEKIT_TOKEN_TTL_SECONDS=600

# LiveKit Inference defaults (no additional provider keys required)
LIVEKIT_STT_MODEL=deepgram/nova-3
LIVEKIT_STT_LANGUAGE=multi
LIVEKIT_LLM_MODEL=google/gemma-4-31b-it
LIVEKIT_TTS_MODEL=inworld/inworld-tts-2
LIVEKIT_TTS_VOICE=Ashley

PORT=4000
